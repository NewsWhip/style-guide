{
    "extends": "../tsconfig.json",
    "files": ["main.ts", "polyfills.ts"],
    "include": ["src/**/*.d.ts", "environments/*.ts"],
    "angularCompilerOptions": {
        /* Angular 22 enables strict template type checking by default. 
         * We set it to false to keep the pre-v22 behaviour until the templates are migrated */
        "strictTemplates": false
    }
}
